<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later: exactly what the phone's backup (the user's Google
     account) and a phone-to-phone transfer copy. Only ArgueLess's four data
     files, in the app's private folder (getApplicationDocumentsDirectory is
     app_flutter/). Nothing else: no caches, no temporary files. Keep in step
     with backup_rules.xml and the About page. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="app_flutter/practice_log.json" />
        <include domain="root" path="app_flutter/reflections.json" />
        <include domain="root" path="app_flutter/settings.json" />
        <include domain="root" path="app_flutter/reminders.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_flutter/practice_log.json" />
        <include domain="root" path="app_flutter/reflections.json" />
        <include domain="root" path="app_flutter/settings.json" />
        <include domain="root" path="app_flutter/reminders.json" />
    </device-transfer>
</data-extraction-rules>
